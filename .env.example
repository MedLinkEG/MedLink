# MedLink Environment Variables
# Copy this file to .env and fill in the values before running docker compose.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/medlink
DB_NAME=medlink
DB_USER=medlink
DB_PASSWORD=change_me

# Spring Boot core-api
SPRING_PORT=8080

# JWT
JWT_SECRET=your-generated-base64-secret
JWT_EXPIRATION_MS=86400000

# Mailjet SMTP
MAILJET_SMTP_HOST=in-v3.mailjet.com
MAILJET_SMTP_PORT=587
MAILJET_SMTP_USERNAME=user
MAILJET_SMTP_PASSWORD=pass
MAILJET_FROM_EMAIL=mail@gmail.com

# OTP Security
OTP_HMAC_SECRET=secret